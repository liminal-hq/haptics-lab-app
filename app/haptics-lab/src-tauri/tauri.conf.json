{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Haptics Lab",
  "version": "0.1.0",
  "identifier": "ca.liminalhq.hapticslab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Haptics Lab",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "materialYou": {
      "cssVariablesPrefix": "m3"
    },
    "haptics": {
      "defaultUsage": "touch",
      "respectSystemHapticsSetting": true,
      "stopBeforePlay": true,
      "maxDurationMs": 10000,
      "maxAmplitude": 255,
      "allowRepeatingWaveforms": false
    }
  }
}
