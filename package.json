{
	"name": "haptics-lab-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"plugin/*",
		"plugin/*/guest-js",
		"app/*"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "bun run --filter haptics-lab dev",
		"prebuild": "bun run --filter @liminal-hq/plugin-haptics build",
		"build": "bun run --filter haptics-lab build",
		"preview": "bun run --filter haptics-lab preview",
		"tauri": "bun run --filter haptics-lab tauri",
		"tauri:dev": "bun run --filter haptics-lab tauri dev",
		"tauri:build": "bun run --filter haptics-lab tauri build",
		"android:init": "bun run --filter haptics-lab tauri android init",
		"android:dev": "bun run --filter haptics-lab tauri android dev",
		"android:build": "bun run --filter haptics-lab tauri android build",
		"icons": "bun run --filter haptics-lab tauri icon ../../assets/icon/icon-1024.png",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"rust:fmt": "cargo fmt --all --check",
		"rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
		"rust:test": "cargo test --workspace",
		"build:plugins": "bun run --filter @liminal-hq/plugin-haptics build && bun run --filter @liminal-hq/plugin-material-you build",
		"postinstall": "bun run build:plugins",
		"validate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run rust:fmt && bun run rust:clippy && bun run rust:test"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vitest": "^2.0.0",
		"prettier": "^3.6.2",
		"eslint": "^9.0.0",
		"@eslint/js": "^9.0.0",
		"globals": "^15.0.0",
		"typescript-eslint": "^8.0.0"
	}
}
